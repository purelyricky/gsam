# Copy to .env and fill in the providers you use.
SAMBANOVA_API_KEY=your-sambanova-key
TOGETHER_API_KEY=your-together-key
OPENAI_API_KEY=your-openai-key
MODAL_API_KEY=your-modal-key
MODAL_API_URL=https://your-modal-endpoint.modal.run/v1

# Optional logging controls (see log_config.py)
GSAM_LOG_LEVEL=INFO
GSAM_LOG_FORMAT=kv
